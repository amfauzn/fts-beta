	// Strategic Resources
	{
		"name": "Aether",
		"resourceType": "Strategic",
		"revealedBy": "Leyline Siphoning",
		"uniques": [
			"Stockpiled",
			"Cannot be traded",
			"Excluded from map editor",
			"Not shown on world screen <without [Aether]>"
		],
		"civilopediaText": [
			{
				"text": "The raw, unrefined, and infinite source of mana. Mana is the concentrated essence that beings interact with to perform magic. Mana can be found in magical items, harvested from nature or collected from ley lines."
			}
		]
	},
	{
		"name": "Fate",
		"resourceType": "Strategic",
		"revealedBy": "Celestial Wisdoms",
		"uniques": [
			"Stockpiled",
			"Cannot be traded",
			"Excluded from map editor",
			"Not shown on world screen <without [Aether]>"
		],
		"civilopediaText": [
			{
				"text": "The invisible, omnipresent force that weaves together the destinies of all living beings, events, and realms in the universe. It is often seen as a cosmic blueprint, dictating the course of individual lives, kingdoms, and even the balance of the world itself. Some see it as a divine plan, others as an inescapable force, while a rare few claim to have the power to bend or break its threads."
			},
			{
				"text": "Those who possess the understanding of this force may use it to summon powerful heroes from the other worlds, bending the threads of fate to bring forth champions destined to change the course of history. Summoning a hero is seen as a desperate and bold action, often reserved for times of great crisis when the natural flow of fate seems inadequate to address the threat at hand. The summoner is not simply changing their own destiny, but the destinies of everyone around them."
			}
		]
	},
